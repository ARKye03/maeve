{
  "manifest_version": 3,
  "name": "Maeve",
  "version": "0.1.0",
  "description": "Sends the TEMU and Mercado Libre product pages you open to the Maeve app on this computer.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Maeve",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://*.temu.com/*", "https://*.mercadolibre.com.uy/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["http://127.0.0.1:47821/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "maeve-extension@maeve.local",
      "strict_min_version": "121.0"
    }
  }
}
